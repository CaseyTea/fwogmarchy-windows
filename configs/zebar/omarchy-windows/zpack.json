{
  "name": "omarchy-windows",
  "version": "0.1.0",
  "description": "Fwog Pond desktop bar",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "index.html",
      "includeFiles": ["index.html", "style.css", "bar.js"],
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "top",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "6px",
          "width": "100%",
          "height": "30px",
          "monitorSelection": {
            "type": "all"
          }
        }
      ]
    }
  ]
}
